# Backend API URL
# Change this to your production URL when you deploy to Vercel
VITE_API_URL=http://localhost:8000/api/v1

# Firebase Web API Key (used for REST auth login endpoint)
# Get this from Firebase Console > Project Settings > General
FIREBASE_WEB_API_KEY=your-firebase-web-api-key-here

# SMTP Email Configuration (for sending invitation emails)
# Get an App Password from: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Application URL (used in invitation emails)
APP_URL=http://localhost:8080

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
